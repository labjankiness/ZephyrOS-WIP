#!/usr/bin/env bash
#
# zephyros-install — ZephyrOS System Installer
#
# A guided TUI installer using dialog that:
#   1. Welcomes the user and shows edition info
#   2. Selects target disk
#   3. Partitions (EFI 512MB + root)
#   4. Formats and mounts partitions
#   5. Installs base system via pacstrap
#   6. Configures bootloader, locale, timezone, hostname
#   7. Creates user account
#   8. Copies edition config and first-boot service
#   9. Reboots into installed system
#
set -euo pipefail

# --- Constants ---
TITLE="ZephyrOS Installer"
BACKTITLE="ZephyrOS Installation"
LOG="/tmp/zephyros-install.log"
MOUNT_DIR="/mnt"

# --- Edition info from live ISO ---
CONF="/etc/zephyros-edition.conf"
EDITION_NAME="core"
EDITION_LABEL="ZephyrOS Core"
OLLAMA_MODEL=""

if [ -f "$CONF" ]; then
    # shellcheck source=/dev/null
    . "$CONF"
fi

# --- Utility functions ---

log() {
    printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG"
}

die() {
    dialog --backtitle "$BACKTITLE" --title "Error" \
        --msgbox "Installation failed:\n\n$1\n\nCheck $LOG for details." 12 60
    exit 1
}

run_cmd() {
    log "Running: $*"
    if ! "$@" >> "$LOG" 2>&1; then
        log "FAILED: $*"
        return 1
    fi
}

# --- Check prerequisites ---
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: This installer must be run as root."
        echo "Try: sudo zephyros-install"
        exit 1
    fi
}

check_uefi() {
    if [ ! -d /sys/firmware/efi ]; then
        dialog --backtitle "$BACKTITLE" --title "UEFI Required" \
            --msgbox "ZephyrOS requires UEFI boot mode.\n\nPlease restart your machine in UEFI mode and try again." 10 60
        exit 1
    fi
}

check_deps() {
    for cmd in dialog pacstrap genfstab arch-chroot sgdisk mkfs.fat mkfs.ext4; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "Error: Required command '$cmd' not found."
            exit 1
        fi
    done
}

# --- Step 1: Welcome ---
step_welcome() {
    dialog --backtitle "$BACKTITLE" --title "$TITLE" \
        --yesno "Welcome to the ZephyrOS Installer!\n\n\
Edition:  $EDITION_LABEL\n\
AI Model: ${OLLAMA_MODEL:-None}\n\n\
This installer will guide you through:\n\
  1. Disk selection and partitioning\n\
  2. System installation\n\
  3. User account creation\n\
  4. Bootloader setup\n\n\
WARNING: The selected disk will be ERASED.\n\n\
Continue?" 20 60

    if [ $? -ne 0 ]; then
        clear
        echo "Installation cancelled."
        exit 0
    fi
}

# --- Step 2: Disk selection ---
step_select_disk() {
    # Build disk list
    local disk_list=()
    local disk

    while IFS= read -r line; do
        disk=$(echo "$line" | awk '{print $1}')
        size=$(echo "$line" | awk '{print $2}')
        model=$(echo "$line" | awk '{$1=$2=""; print $0}' | sed 's/^ *//')
        [ -z "$model" ] && model="Unknown"
        disk_list+=("$disk" "$size  $model")
    done < <(lsblk -dno NAME,SIZE,MODEL | grep -E '^(sd|vd|nvme)' | sort)

    if [ ${#disk_list[@]} -eq 0 ]; then
        die "No suitable disks found.\n\nMake sure a virtual disk is attached."
    fi

    SELECTED_DISK=$(dialog --backtitle "$BACKTITLE" --title "Select Disk" \
        --menu "Choose the disk to install ZephyrOS on.\n\nWARNING: ALL data on the selected disk will be erased!" \
        18 70 6 "${disk_list[@]}" 3>&1 1>&2 2>&3)

    if [ $? -ne 0 ] || [ -z "$SELECTED_DISK" ]; then
        clear
        echo "Installation cancelled."
        exit 0
    fi

    TARGET_DISK="/dev/$SELECTED_DISK"

    # Confirm
    local disk_size
    disk_size=$(lsblk -dno SIZE "$TARGET_DISK" 2>/dev/null || echo "unknown")

    dialog --backtitle "$BACKTITLE" --title "Confirm Disk" \
        --yesno "You selected:\n\n\
  Disk: $TARGET_DISK\n\
  Size: $disk_size\n\n\
ALL DATA ON THIS DISK WILL BE PERMANENTLY ERASED.\n\n\
Are you absolutely sure?" 14 60

    if [ $? -ne 0 ]; then
        clear
        echo "Installation cancelled."
        exit 0
    fi
}

# --- Step 3: User configuration ---
step_user_config() {
    # Hostname
    HOSTNAME=$(dialog --backtitle "$BACKTITLE" --title "Hostname" \
        --inputbox "Enter a hostname for this machine:" 10 50 "zephyros" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && exit 0
    [ -z "$HOSTNAME" ] && HOSTNAME="zephyros"

    # Username
    USERNAME=$(dialog --backtitle "$BACKTITLE" --title "User Account" \
        --inputbox "Enter a username:" 10 50 "" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && exit 0

    if [ -z "$USERNAME" ]; then
        die "Username cannot be empty."
    fi

    # Password
    PASSWORD=$(dialog --backtitle "$BACKTITLE" --title "Password" \
        --insecure --passwordbox "Enter a password for $USERNAME:" 10 50 \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && exit 0

    PASSWORD_CONFIRM=$(dialog --backtitle "$BACKTITLE" --title "Confirm Password" \
        --insecure --passwordbox "Confirm password:" 10 50 \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && exit 0

    if [ "$PASSWORD" != "$PASSWORD_CONFIRM" ]; then
        die "Passwords do not match."
    fi

    if [ -z "$PASSWORD" ]; then
        die "Password cannot be empty."
    fi

    # Timezone
    TIMEZONE=$(dialog --backtitle "$BACKTITLE" --title "Timezone" \
        --inputbox "Enter your timezone (e.g., Asia/Singapore, US/Eastern):" \
        10 60 "Asia/Singapore" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && exit 0
    [ -z "$TIMEZONE" ] && TIMEZONE="UTC"

    # Keyboard layout (console keymap). Common subset; "us" default.
    KEYMAP=$(dialog --backtitle "$BACKTITLE" --title "Keyboard Layout" \
        --menu "Select a console keyboard layout:" 18 60 8 \
        "us"      "English (US)" \
        "uk"      "English (UK)" \
        "de"      "German" \
        "fr"      "French (AZERTY)" \
        "es"      "Spanish" \
        "it"      "Italian" \
        "dvorak"  "Dvorak (US)" \
        "us"      "Other / pick later" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && exit 0
    [ -z "$KEYMAP" ] && KEYMAP="us"

    # System locale. Common UTF-8 subset; en_US.UTF-8 default.
    LOCALE=$(dialog --backtitle "$BACKTITLE" --title "Locale" \
        --menu "Select a system locale (language + formats):" 18 60 8 \
        "en_US.UTF-8" "English (United States)" \
        "en_GB.UTF-8" "English (United Kingdom)" \
        "de_DE.UTF-8" "German (Germany)" \
        "fr_FR.UTF-8" "French (France)" \
        "es_ES.UTF-8" "Spanish (Spain)" \
        "it_IT.UTF-8" "Italian (Italy)" \
        "ja_JP.UTF-8" "Japanese (Japan)" \
        "zh_CN.UTF-8" "Chinese (Simplified)" \
        3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && exit 0
    [ -z "$LOCALE" ] && LOCALE="en_US.UTF-8"
}

# --- Step 3b: Disk encryption choice ---
step_encryption() {
    ENCRYPT=0
    # dialog goes in the if-condition so `set -e` doesn't abort on "No".
    # Declining here means a normal unencrypted install — not a cancel.
    if ! dialog --backtitle "$BACKTITLE" --title "Disk Encryption" \
        --yesno "Encrypt the root partition with LUKS2?\n\n\
Strongly recommended for laptops and any portable machine — without it,\n\
anyone with physical access can read your data.\n\n\
You will be asked for a passphrase at every boot. If you forget it, the\n\
data is unrecoverable.\n\n\
Enable full-disk encryption?" 16 64; then
        return
    fi

    if ! command -v cryptsetup >/dev/null 2>&1; then
        die "cryptsetup is not available in this live environment.\n\nCannot enable encryption."
    fi

    local p1 p2
    while true; do
        # `|| return` keeps these set -e-safe; cancelling falls back to
        # an unencrypted install rather than aborting the installer.
        p1=$(dialog --backtitle "$BACKTITLE" --title "Encryption Passphrase" \
            --insecure --passwordbox "Enter a disk-encryption passphrase:" 10 60 \
            3>&1 1>&2 2>&3) || return
        p2=$(dialog --backtitle "$BACKTITLE" --title "Confirm Passphrase" \
            --insecure --passwordbox "Confirm the disk-encryption passphrase:" 10 60 \
            3>&1 1>&2 2>&3) || return
        if [ "$p1" != "$p2" ]; then
            dialog --backtitle "$BACKTITLE" --title "Mismatch" \
                --msgbox "Passphrases do not match. Try again." 8 50
            continue
        fi
        if [ -z "$p1" ]; then
            dialog --backtitle "$BACKTITLE" --title "Empty" \
                --msgbox "Passphrase cannot be empty. Try again." 8 50
            continue
        fi
        break
    done
    LUKS_PASSPHRASE="$p1"
    ENCRYPT=1
}

# --- Step 4: Partition and format ---
#
# Two layouts:
#   - Unencrypted: ESP 512MB mounted at /boot/efi, ext4 root mounted at /.
#   - Encrypted  : ESP 1GiB mounted at /boot (holds kernel + initramfs,
#                  unencrypted), LUKS2 on the root partition opened as
#                  /dev/mapper/cryptroot and mounted at /. A single passphrase
#                  prompt at boot — no GRUB cryptodisk double-unlock.
step_partition() {
    # ESP size depends on layout: encrypted keeps kernels on the ESP.
    local esp_end="+512M"
    [ "${ENCRYPT:-0}" -eq 1 ] && esp_end="+1024M"

    (
        echo "10"; echo "XXX"; echo "Wiping disk..."; echo "XXX"
        run_cmd sgdisk --zap-all "$TARGET_DISK" || true

        echo "20"; echo "XXX"; echo "Creating EFI system partition..."; echo "XXX"
        run_cmd sgdisk -n 1:0:"$esp_end" -t 1:ef00 -c 1:"EFI" "$TARGET_DISK"

        echo "30"; echo "XXX"; echo "Creating root partition..."; echo "XXX"
        run_cmd sgdisk -n 2:0:0 -t 2:8300 -c 2:"ZephyrOS" "$TARGET_DISK"

        # Determine partition names (handles nvme naming: nvmeXnYpZ)
        sleep 1
        run_cmd partprobe "$TARGET_DISK"
        sleep 1

        if echo "$TARGET_DISK" | grep -q "nvme"; then
            EFI_PART="${TARGET_DISK}p1"
            ROOT_PART="${TARGET_DISK}p2"
        else
            EFI_PART="${TARGET_DISK}1"
            ROOT_PART="${TARGET_DISK}2"
        fi

        # Save partition paths for later steps (subshell can't export upward)
        echo "$EFI_PART" > /tmp/zephyros-efi-part
        echo "$ROOT_PART" > /tmp/zephyros-root-part

        echo "45"; echo "XXX"; echo "Formatting EFI partition (FAT32)..."; echo "XXX"
        run_cmd mkfs.fat -F32 -n "ZEPHYREFI" "$EFI_PART"

        if [ "${ENCRYPT:-0}" -eq 1 ]; then
            echo "60"; echo "XXX"; echo "Encrypting root partition (LUKS2)..."; echo "XXX"
            # Feed the passphrase on stdin (no --key-file, so cryptsetup treats
            # it as an interactive-equivalent passphrase — exactly what the user
            # types at boot). --batch-mode skips the confirmation prompt.
            printf '%s' "$LUKS_PASSPHRASE" | \
                run_cmd cryptsetup luksFormat --type luks2 --batch-mode "$ROOT_PART"
            printf '%s' "$LUKS_PASSPHRASE" | \
                run_cmd cryptsetup luksOpen "$ROOT_PART" cryptroot
            ROOT_FS="/dev/mapper/cryptroot"
        else
            ROOT_FS="$ROOT_PART"
        fi
        echo "$ROOT_FS" > /tmp/zephyros-root-fs

        echo "75"; echo "XXX"; echo "Formatting root filesystem (ext4)..."; echo "XXX"
        run_cmd mkfs.ext4 -L "ZephyrOS" -F "$ROOT_FS"

        echo "90"; echo "XXX"; echo "Mounting partitions..."; echo "XXX"
        run_cmd mount "$ROOT_FS" "$MOUNT_DIR"
        if [ "${ENCRYPT:-0}" -eq 1 ]; then
            # ESP at /boot — kernel + initramfs live here, unencrypted.
            run_cmd mkdir -p "$MOUNT_DIR/boot"
            run_cmd mount "$EFI_PART" "$MOUNT_DIR/boot"
        else
            run_cmd mkdir -p "$MOUNT_DIR/boot/efi"
            run_cmd mount "$EFI_PART" "$MOUNT_DIR/boot/efi"
        fi

        echo "100"; echo "XXX"; echo "Partitioning complete."; echo "XXX"
    ) | dialog --backtitle "$BACKTITLE" --title "Partitioning" --gauge "Preparing disk..." 10 60 0

    EFI_PART=$(cat /tmp/zephyros-efi-part)
    ROOT_PART=$(cat /tmp/zephyros-root-part)
    ROOT_FS=$(cat /tmp/zephyros-root-fs)

    # LUKS UUID of the underlying partition — needed for the kernel cmdline.
    if [ "${ENCRYPT:-0}" -eq 1 ]; then
        LUKS_UUID=$(cryptsetup luksUUID "$ROOT_PART")
        log "LUKS UUID: $LUKS_UUID"
    fi
}

# --- Step 5: Install base system ---
step_install() {
    dialog --backtitle "$BACKTITLE" --title "Installing System" \
        --infobox "Installing ZephyrOS base system...\n\nThis may take several minutes depending on your internet speed.\n\nPlease wait..." 10 60

    log "Running pacstrap..."

    # Get the package list from the live ISO
    LIVE_PKG_LIST="/usr/local/share/zephyros/packages.x86_64"
    if [ -f "$LIVE_PKG_LIST" ]; then
        # Read packages from the edition's merged list
        PACKAGES=$(grep -v '^\s*#' "$LIVE_PKG_LIST" | grep -v '^\s*$' | tr '\n' ' ')
    else
        # Fallback: install base + essential packages
        PACKAGES="base linux linux-firmware grub efibootmgr networkmanager sudo"
    fi

    # Run pacstrap
    if ! pacstrap -K "$MOUNT_DIR" $PACKAGES >> "$LOG" 2>&1; then
        # Retry with just base if full list fails
        log "Full pacstrap failed, trying minimal install..."
        if ! pacstrap -K "$MOUNT_DIR" base linux linux-firmware grub efibootmgr networkmanager sudo >> "$LOG" 2>&1; then
            die "pacstrap failed. Check your internet connection and try again."
        fi
    fi

    log "pacstrap complete"
}

# --- Step 6: Configure system ---
step_configure() {
    (
        echo "5"; echo "XXX"; echo "Generating fstab..."; echo "XXX"
        genfstab -U "$MOUNT_DIR" >> "$MOUNT_DIR/etc/fstab"

        echo "10"; echo "XXX"; echo "Creating swapfile..."; echo "XXX"
        # Size swap to RAM, capped at 8 GiB. Enough for OOM relief; full RAM
        # would only matter for hibernation, which we handle best-effort below.
        SWAP_MB=$(awk '/MemTotal/ {mb=int($2/1024); print (mb>8192?8192:mb)}' /proc/meminfo)
        [ -z "$SWAP_MB" ] && SWAP_MB=2048
        if ! fallocate -l "${SWAP_MB}M" "$MOUNT_DIR/swapfile" 2>>"$LOG"; then
            dd if=/dev/zero of="$MOUNT_DIR/swapfile" bs=1M count="$SWAP_MB" >>"$LOG" 2>&1
        fi
        chmod 600 "$MOUNT_DIR/swapfile"
        run_cmd mkswap "$MOUNT_DIR/swapfile"
        echo "/swapfile none swap defaults 0 0" >> "$MOUNT_DIR/etc/fstab"

        # Hibernation (resume) — only attempted on unencrypted ext4 root, where
        # computing the swapfile's physical offset is reliable. With LUKS the
        # offset/UUID handling is fragile, so we ship swap-only there.
        RESUME_PARAMS=""
        if [ "${ENCRYPT:-0}" -ne 1 ]; then
            SWAP_OFFSET=$(filefrag -v "$MOUNT_DIR/swapfile" 2>/dev/null \
                | awk '$1=="0:" {print substr($4, 1, length($4)-2); exit}')
            RESUME_UUID=$(blkid -s UUID -o value "$ROOT_FS" 2>/dev/null)
            if [ -n "$SWAP_OFFSET" ] && [ -n "$RESUME_UUID" ]; then
                RESUME_PARAMS="resume=UUID=${RESUME_UUID} resume_offset=${SWAP_OFFSET}"
                log "Hibernation enabled: $RESUME_PARAMS"
            fi
        fi

        echo "15"; echo "XXX"; echo "Setting timezone ($TIMEZONE)..."; echo "XXX"
        arch-chroot "$MOUNT_DIR" ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime 2>>"$LOG" || \
            arch-chroot "$MOUNT_DIR" ln -sf /usr/share/zoneinfo/UTC /etc/localtime 2>>"$LOG"
        arch-chroot "$MOUNT_DIR" hwclock --systohc 2>>"$LOG"

        echo "25"; echo "XXX"; echo "Setting locale ($LOCALE) and keymap ($KEYMAP)..."; echo "XXX"
        echo "${LOCALE} ${LOCALE##*.}" > "$MOUNT_DIR/etc/locale.gen"
        arch-chroot "$MOUNT_DIR" locale-gen >> "$LOG" 2>&1
        echo "LANG=${LOCALE}" > "$MOUNT_DIR/etc/locale.conf"
        # Console keymap (also picked up as the default for Wayland/labwc).
        echo "KEYMAP=${KEYMAP}" > "$MOUNT_DIR/etc/vconsole.conf"

        echo "35"; echo "XXX"; echo "Setting hostname ($HOSTNAME)..."; echo "XXX"
        echo "$HOSTNAME" > "$MOUNT_DIR/etc/hostname"
        cat > "$MOUNT_DIR/etc/hosts" <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME.localdomain $HOSTNAME
HOSTS

        echo "45"; echo "XXX"; echo "Creating user $USERNAME..."; echo "XXX"
        arch-chroot "$MOUNT_DIR" useradd -m -G wheel,video,audio,input -s /bin/zsh "$USERNAME" >> "$LOG" 2>&1 || \
            arch-chroot "$MOUNT_DIR" useradd -m -G wheel,video,audio,input -s /bin/bash "$USERNAME" >> "$LOG" 2>&1
        echo "$USERNAME:$PASSWORD" | arch-chroot "$MOUNT_DIR" chpasswd >> "$LOG" 2>&1

        # Enable sudo for wheel group
        echo "%wheel ALL=(ALL:ALL) ALL" > "$MOUNT_DIR/etc/sudoers.d/wheel"
        chmod 440 "$MOUNT_DIR/etc/sudoers.d/wheel"

        echo "50"; echo "XXX"; echo "Configuring initramfs hooks..."; echo "XXX"
        # Adjust mkinitcpio HOOKS for encryption and/or hibernation, then
        # regenerate the initramfs so the changes take effect at boot.
        MKICONF="$MOUNT_DIR/etc/mkinitcpio.conf"
        if [ "${ENCRYPT:-0}" -eq 1 ] && ! grep -q '\bencrypt\b' "$MKICONF"; then
            # 'encrypt' must run before 'filesystems' to unlock root.
            sed -i 's/\bfilesystems\b/encrypt filesystems/' "$MKICONF"
        fi
        if [ -n "$RESUME_PARAMS" ] && ! grep -q '\bresume\b' "$MKICONF"; then
            # 'resume' must run after 'filesystems'.
            sed -i 's/\bfilesystems\b/filesystems resume/' "$MKICONF"
        fi
        arch-chroot "$MOUNT_DIR" mkinitcpio -P >> "$LOG" 2>&1 || true

        echo "55"; echo "XXX"; echo "Installing GRUB bootloader..."; echo "XXX"
        # Assemble kernel command line: encryption + hibernation params.
        EXTRA_CMDLINE=""
        if [ "${ENCRYPT:-0}" -eq 1 ]; then
            EXTRA_CMDLINE="cryptdevice=UUID=${LUKS_UUID}:cryptroot root=/dev/mapper/cryptroot"
        fi
        if [ -n "$RESUME_PARAMS" ]; then
            EXTRA_CMDLINE="${EXTRA_CMDLINE:+$EXTRA_CMDLINE }${RESUME_PARAMS}"
        fi
        if [ -n "$EXTRA_CMDLINE" ]; then
            # Append our params inside the existing GRUB_CMDLINE_LINUX_DEFAULT="...".
            sed -i "s|^\(GRUB_CMDLINE_LINUX_DEFAULT=\".*\)\"|\1 ${EXTRA_CMDLINE}\"|" \
                "$MOUNT_DIR/etc/default/grub"
        fi

        # With encryption the ESP is mounted at /boot; otherwise at /boot/efi.
        if [ "${ENCRYPT:-0}" -eq 1 ]; then
            GRUB_EFI_DIR="/boot"
        else
            GRUB_EFI_DIR="/boot/efi"
        fi
        arch-chroot "$MOUNT_DIR" grub-install --target=x86_64-efi \
            --efi-directory="$GRUB_EFI_DIR" --bootloader-id=ZephyrOS \
            --recheck >> "$LOG" 2>&1 || die "GRUB installation failed."
        arch-chroot "$MOUNT_DIR" grub-mkconfig -o /boot/grub/grub.cfg >> "$LOG" 2>&1

        echo "65"; echo "XXX"; echo "Enabling services..."; echo "XXX"
        arch-chroot "$MOUNT_DIR" systemctl enable NetworkManager >> "$LOG" 2>&1
        arch-chroot "$MOUNT_DIR" systemctl enable systemd-timesyncd >> "$LOG" 2>&1
        # Phase 3: power, thermal, bluetooth. Harmless on desktops / AMD hosts.
        arch-chroot "$MOUNT_DIR" systemctl enable tlp.service >> "$LOG" 2>&1 || true
        arch-chroot "$MOUNT_DIR" systemctl enable thermald.service >> "$LOG" 2>&1 || true
        arch-chroot "$MOUNT_DIR" systemctl enable bluetooth.service >> "$LOG" 2>&1 || true
        # TLP and systemd-rfkill conflict on resume; mask per TLP upstream guidance.
        arch-chroot "$MOUNT_DIR" systemctl mask systemd-rfkill.service >> "$LOG" 2>&1 || true
        arch-chroot "$MOUNT_DIR" systemctl mask systemd-rfkill.socket >> "$LOG" 2>&1 || true
        # Phase 5: firewall (default-deny inbound). Ruleset shipped at /etc/nftables.conf.
        arch-chroot "$MOUNT_DIR" systemctl enable nftables.service >> "$LOG" 2>&1 || true

        echo "75"; echo "XXX"; echo "Copying edition configuration..."; echo "XXX"
        # Copy edition config
        if [ -f "$CONF" ]; then
            cp "$CONF" "$MOUNT_DIR/etc/zephyros-edition.conf"
        fi

        # Copy first-boot service and script
        if [ -f /usr/local/bin/zephyros-firstboot.sh ]; then
            cp /usr/local/bin/zephyros-firstboot.sh "$MOUNT_DIR/usr/local/bin/zephyros-firstboot.sh"
            chmod 755 "$MOUNT_DIR/usr/local/bin/zephyros-firstboot.sh"
        fi
        if [ -f /usr/lib/systemd/system/zephyros-firstboot.service ]; then
            cp /usr/lib/systemd/system/zephyros-firstboot.service \
                "$MOUNT_DIR/usr/lib/systemd/system/zephyros-firstboot.service"
            arch-chroot "$MOUNT_DIR" systemctl enable zephyros-firstboot.service >> "$LOG" 2>&1
        fi

        # Copy AI wrapper
        if [ -f /usr/local/bin/zephyros-ai ]; then
            cp /usr/local/bin/zephyros-ai "$MOUNT_DIR/usr/local/bin/zephyros-ai"
            chmod 755 "$MOUNT_DIR/usr/local/bin/zephyros-ai"
        fi

        # Copy Phase 3 diagnostic tools (hwreport / bootreport / telemetry-audit)
        for tool in zephyros-hwreport zephyros-bootreport zephyros-telemetry-audit; do
            if [ -f "/usr/local/bin/$tool" ]; then
                cp "/usr/local/bin/$tool" "$MOUNT_DIR/usr/local/bin/$tool"
                chmod 755 "$MOUNT_DIR/usr/local/bin/$tool"
            fi
        done

        # Copy TLP baseline drop-in if present in the live image
        if [ -f /etc/tlp.d/00-zephyros.conf ]; then
            mkdir -p "$MOUNT_DIR/etc/tlp.d"
            cp /etc/tlp.d/00-zephyros.conf "$MOUNT_DIR/etc/tlp.d/00-zephyros.conf"
        fi

        # Copy the ZephyrOS firewall ruleset over the nftables package default.
        if [ -f /etc/nftables.conf ]; then
            cp /etc/nftables.conf "$MOUNT_DIR/etc/nftables.conf"
        fi

        echo "85"; echo "XXX"; echo "Applying ZephyrOS theme..."; echo "XXX"
        # Copy dotfiles to new user's home
        USER_HOME="$MOUNT_DIR/home/$USERNAME"
        mkdir -p "$USER_HOME/.config"

        # Copy configs from live environment if available
        for conf_dir in wayfire.ini; do
            if [ -f "/etc/skel/.config/$conf_dir" ]; then
                cp "/etc/skel/.config/$conf_dir" "$USER_HOME/.config/$conf_dir"
            fi
        done

        for conf_dir in kitty wofi wf-panel-pi; do
            if [ -d "/etc/skel/.config/$conf_dir" ]; then
                cp -a "/etc/skel/.config/$conf_dir" "$USER_HOME/.config/$conf_dir"
            fi
        done

        if [ -f /etc/skel/.zshrc ]; then
            cp /etc/skel/.zshrc "$USER_HOME/.zshrc"
        fi

        # Fix ownership
        arch-chroot "$MOUNT_DIR" chown -R "$USERNAME:$USERNAME" "/home/$USERNAME" >> "$LOG" 2>&1

        # Copy MOTD if available
        if [ -f /etc/zephyros-motd ]; then
            cp /etc/zephyros-motd "$MOUNT_DIR/etc/zephyros-motd"
        fi

        echo "95"; echo "XXX"; echo "Setting up Wayfire auto-start..."; echo "XXX"
        # Auto-start Wayfire on login (TTY1)
        ZPROFILE="$USER_HOME/.zprofile"
        cat > "$ZPROFILE" <<'ZPROF'
# Auto-start Wayfire on TTY1
if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
    exec wayfire
fi
ZPROF
        arch-chroot "$MOUNT_DIR" chown "$USERNAME:$USERNAME" "/home/$USERNAME/.zprofile" >> "$LOG" 2>&1

        # Enable autologin on TTY1 for the user
        mkdir -p "$MOUNT_DIR/etc/systemd/system/getty@tty1.service.d"
        cat > "$MOUNT_DIR/etc/systemd/system/getty@tty1.service.d/autologin.conf" <<AUTOLOGIN
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $USERNAME --noclear %I \$TERM
AUTOLOGIN

        echo "100"; echo "XXX"; echo "Configuration complete!"; echo "XXX"
    ) | dialog --backtitle "$BACKTITLE" --title "Configuring System" --gauge "Configuring..." 10 60 0
}

# --- Step 7: Finish ---
step_finish() {
    # Unmount
    log "Unmounting partitions..."
    umount -R "$MOUNT_DIR" >> "$LOG" 2>&1 || true
    if [ "${ENCRYPT:-0}" -eq 1 ]; then
        cryptsetup luksClose cryptroot >> "$LOG" 2>&1 || true
    fi

    local enc_status="No"
    [ "${ENCRYPT:-0}" -eq 1 ] && enc_status="Yes (LUKS2)"

    dialog --backtitle "$BACKTITLE" --title "Installation Complete!" \
        --yesno "ZephyrOS $EDITION_LABEL has been installed successfully!\n\n\
User:       $USERNAME\n\
Hostname:   $HOSTNAME\n\
Timezone:   $TIMEZONE\n\
Locale:     $LOCALE\n\
Keymap:     $KEYMAP\n\
Encrypted:  $enc_status\n\
Firewall:   nftables (default-deny inbound)\n\
AI Model:   ${OLLAMA_MODEL:-None}\n\n\
On first boot, the AI model will be automatically downloaded\n\
(requires internet connection).\n\n\
Remove the installation media and reboot now?" 22 64

    if [ $? -eq 0 ]; then
        reboot
    else
        clear
        echo "Installation complete. You can reboot manually when ready."
        echo "Remember to remove the installation media before rebooting."
    fi
}

# --- Main ---
main() {
    check_root
    check_deps
    check_uefi

    > "$LOG"
    log "ZephyrOS installer started"
    log "Edition: $EDITION_LABEL"

    step_welcome
    step_select_disk
    step_encryption
    step_user_config
    step_partition
    step_install
    step_configure
    step_finish
}

main "$@"
